# Postgres. Locally this is the docker-compose container (host port 5433, to
# avoid colliding with a system-installed PostgreSQL on 5432).
DATABASE_URL="postgresql://user:password@localhost:5433/game_database"

# Production only. Neon gives you two connection strings: the pooled one goes in
# DATABASE_URL above and serves the app, and the direct one goes here, where
# migrations, the extension bootstrap and the ingest use it instead. DDL and
# long transactions don't work through pgbouncer's transaction pooling. Leave
# this unset locally — there's only one endpoint.
# DATABASE_URL_UNPOOLED=""

# IGDB (via Twitch). Register an application at https://dev.twitch.tv/console/apps
# to get these — the API is free but requires OAuth client credentials.
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""

# Which games to ingest, as an APICalypse filter. The default below is ~46k of
# IGDB's ~372k entries: everything with a cover that is either rated or
# anticipated. `cover != null` on its own is ~313k and needs a few GB.
# IGDB_GAME_FILTER="cover != null & (total_rating_count >= 1 | hypes >= 1)"

# Auth.js. Generate the secret with: npx auth secret
AUTH_SECRET=""

# GitHub OAuth app: https://github.com/settings/developers
# One app covers both environments — it accepts multiple redirect URIs. Add
#   https://<your-deployment>/api/auth/callback/github
#   http://localhost:3000/api/auth/callback/github
# and leave wildcard matching off; Vercel gives every preview its own subdomain,
# so a wildcard would make OAuth codes valid at URLs you don't control.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
